# WordPress Story Desk
WORDPRESS_BASE_URL=https://example.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Optional while developing: set true to print candidates instead of sending to WordPress.
DRY_RUN=true

# Maximum candidates sent to WordPress per run.
MAX_CANDIDATES=25

# Minimum total PSA score (0-100) required to enter Story Desk.
MIN_PSA_SCORE=60

# Suppress candidates at or above this community-risk score.
MAX_COMMUNITY_RISK=70

# HTTP identification.
USER_AGENT=ProStoriesAotearoa/0.1 (+https://prostories.nz)
